<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MovieDetailActivity">

    <!-- Шапка с постером/фоном и рейтингом -->
    <View
        android:id="@+id/headerBase"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="#E0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/headerOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#424242"
        app:layout_constraintStart_toStartOf="@id/headerBase"
        app:layout_constraintEnd_toEndOf="@id/headerBase"
        app:layout_constraintTop_toTopOf="@id/headerBase"
        app:layout_constraintBottom_toBottomOf="@id/headerBase" />

    <TextView
        android:id="@+id/ratingTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="#CC000000"
        android:padding="12dp"
        android:textColor="#FFD700"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/headerBase"
        app:layout_constraintEnd_toEndOf="@id/headerBase"
        tools:text="9.3" />

    <!-- Контент -->
    <TextView
        android:id="@+id/greetingTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#4CAF50"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBase"
        tools:text="Привет, Иван!"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/greetingTextView"
        tools:text="Побег из Шоушенка" />

    <TextView
        android:id="@+id/infoTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleTextView"
        tools:text="1994 • Драма • 2ч 22мин" />

    <TextView
        android:id="@+id/descriptionTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:textSize="14sp"
        android:textColor="#000000"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/infoTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/randomButton"
        tools:text="Бухгалтер Энди Дюфрейн обвинён в убийстве собственной жены и её любовника..." />

    <!-- Ряд 1: Случайный фильм / Подробнее -->
    <Button
        android:id="@+id/randomButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/random_movie"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/moreInfoButton"
        app:layout_constraintTop_toBottomOf="@id/descriptionTextView"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <Button
        android:id="@+id/moreInfoButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/more_info"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/randomButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/randomButton" />

    <!-- Ряд 2: Другой фильм / Профиль -->
    <Button
        android:id="@+id/anotherMovieButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Другой фильм"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/profileButton"
        app:layout_constraintTop_toBottomOf="@id/randomButton"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <Button
        android:id="@+id/profileButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/profile"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/anotherMovieButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/anotherMovieButton" />

    <!-- Ряд 3: Карточка актёра -->
    <Button
        android:id="@+id/actorButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/actor_card"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/anotherMovieButton"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
