<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout для экрана профиля пользователя.
    
    TODO (Домашнее задание): Создайте layout для ProfileActivity со следующими элементами:
    
    1. Вертикальный LinearLayout (padding 16dp)
    2. TextView для приветствия "Привет, [Имя]!" (изначально gone)
    3. EditText для имени (hint: "Введите ваше имя")
    4. EditText для возраста (hint: "Введите возраст", inputType: number)
    5. TextView "Любимый жанр"
    6. Spinner для выбора жанра
    7. TextView для ошибки жанра (textColor: red, изначально gone)
    8. EditText для "О себе" (hint: "Расскажите о себе", multiline, minLines: 3)
    9. Space с layout_weight="1" (для push кнопок вниз)
    10. TextView для версии приложения
    11. Горизонтальный LinearLayout с кнопками "Отмена" и "Сохранить"
    
    ВАЖНО: Используйте LinearLayout и FrameLayout, НЕ ConstraintLayout!
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ProfileActivity">

        <TextView
            android:id="@+id/greetingTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Привет, [Имя]!"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Имя"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/nameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите ваше имя" />

        <TextView
            android:id="@+id/nameErrorTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Имя должно быть от 2 до 40 символов"
            android:textColor="#FF0000"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Возраст"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/ageEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите возраст"
            android:inputType="number" />

        <TextView
            android:id="@+id/ageErrorTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Возраст должен быть от 10 до 120 лет"
            android:textColor="#FF0000"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Любимый жанр"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <Spinner
            android:id="@+id/genreSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/genreErrorTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Пожалуйста, выберите жанр"
            android:textColor="#FF0000"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="О себе"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/bioEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Расскажите о себе"
            android:inputType="textMultiLine"
            android:minLines="3" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/versionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Версия приложения: 1.0"
            android:textColor="#666666" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/cancelButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Отмена" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Сохранить" />

        </LinearLayout>

</LinearLayout>
