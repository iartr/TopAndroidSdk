<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ProfileActivity">

    <!-- Приветствие (изначально скрыто) -->
    <TextView
        android:id="@+id/greetingTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        tools:text="Привет, Иван!"
        tools:visibility="visible" />

    <!-- Поле ввода имени -->
    <EditText
        android:id="@+id/nameEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/name_hint"
        android:inputType="textPersonName"
        android:maxLines="1" />

    <!-- Поле ввода возраста -->
    <EditText
        android:id="@+id/ageEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/age_hint"
        android:inputType="number"
        android:maxLines="1" />

    <!-- Метка для Spinner -->
    <TextView
        android:id="@+id/genreLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/favorite_genre"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Spinner для выбора жанра -->
    <Spinner
        android:id="@+id/genreSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <!-- Сообщение об ошибке жанра -->
    <TextView
        android:id="@+id/genreErrorTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/genre_error"
        android:textColor="#F44336"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Поле "О себе" (многострочное) -->
    <EditText
        android:id="@+id/aboutEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/about_hint"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:gravity="top|start" />

    <!-- Пространство для push кнопок вниз -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Версия приложения -->
    <TextView
        android:id="@+id/versionTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        tools:text="Версия приложения: 1.0" />

    <!-- Кнопки "Отмена" и "Сохранить" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/save"
            android:enabled="false" />

    </LinearLayout>

</LinearLayout>
